# === KBI PROJECT - ENVIRONMENT VARIABLES ===
# هذا ملف مثال للمتغيرات البيئية
# IMPORTANT: تم إضافة .env و .env.local إلى .gitignore
# يجب عدم نشر هذا الملف على GitHub!

# قاعدة البيانات (Turso SQLite)
# الحصول على الرابط: 
#   1. اذهب إلى https://turso.tech
#   2. سجل دخول أو أنشئ حساب
#   3. اذهب إلى terminal وشغل: turso db tokens create kbi-db --expiration never
#   4. انسخ الرابط الذي تحصل عليه
DATABASE_URL="libsql://your-db-name-username.turso.io?authToken=your-token-here"

# Node Environment - لا تغيّره إلا لو كنت تختبر locally
NODE_ENV="development"

# اختياري: API URLs
NEXT_PUBLIC_API_URL="http://localhost:3000"

# اختياري: الـ Features flags
NEXT_PUBLIC_ENABLE_ANALYTICS="true"
NEXT_PUBLIC_APP_NAME="KBI"
NEXT_PUBLIC_APP_VERSION="0.2.1"

# === للـ Production (Cloudflare) ===
# استخدم نفس DATABASE_URL لكن مع token مختلف (optional)
# NODE_ENV=production
# NEXT_PUBLIC_API_URL=https://kbi.pages.dev
